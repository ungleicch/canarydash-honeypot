#!/bin/bash
# Daily: archive rotated Cowrie JSON logs + session recordings (tty) + captured downloads to blob. Nothing is deleted locally.
L=/opt/cowrie/cowrie/var/log/cowrie; V=/opt/cowrie/cowrie/var/lib/cowrie
for f in $L/cowrie.json.20*; do
  case "$f" in *.gz|*.uploaded) continue;; esac
  [ -e "$f.uploaded" ] && continue
  d=$(basename "$f" | sed -E 's/cowrie\.json\.([0-9]{4})-([0-9]{2})-([0-9]{2})/\1\/\2\/\3/')
  gzip -c "$f" > /tmp/cj.gz && /opt/canary-tools/blob_put.sh /tmp/cj.gz "cowrie/$d/cowrie.json.gz" && touch "$f.uploaded"
done
day=$(date -u +%Y/%m/%d)
tar czf /tmp/cowrie-artifacts.tgz -C $V tty downloads 2>/dev/null && /opt/canary-tools/blob_put.sh /tmp/cowrie-artifacts.tgz "cowrie/$day/artifacts.tgz"
