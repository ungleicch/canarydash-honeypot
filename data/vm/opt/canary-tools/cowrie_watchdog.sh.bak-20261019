#!/bin/sh
# Restart Cowrie if its log has gone silent for 30+ min (hang with full accept queue).
LOG=/opt/cowrie/cowrie/var/log/cowrie/cowrie.json
OUT=/var/log/cowrie_watchdog.log
now=$(date +%s); m=$(stat -c %Y "$LOG" 2>/dev/null || echo 0)
age=$((now-m))
if [ "$age" -gt 1800 ] || ! systemctl is-active -q cowrie; then
  echo "$(date -u +%FT%TZ) restart: log idle ${age}s" >> $OUT
  systemctl restart cowrie
fi
