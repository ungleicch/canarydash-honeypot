{"session":"f0f80f34111b","protocol":"telnet","src_ip":"191.98.239.177","src_port":43210,"dst_ip":"10.0.0.4","dst_port":23,"input":"#!/bin/sh\n\nfor proc_dir in /proc/*; do\n    pid=${proc_dir##*/}\n\n    result=$(ls -l \"/proc/$pid/exe\" 2> /dev/null)\n\n    if [ \"$result\" != \"${result%(deleted)}\" ]; then\n        kill -9 \"$pid\"\n    fi\ndone\n","eventid":"cowrie.command.input","sensor":"opencanary","uuid":"d0d85c47-c860-11f1-853c-7ced8dc9878c","timestamp":"2026-10-17T23:45:13.711380Z","message":"CMD: #!/bin/sh\n\nfor proc_dir in /proc/*; do\n    pid=${proc_dir##*/}\n\n    result=$(ls -l \"/proc/$pid/exe\" 2> /dev/null)\n\n    if [ \"$result\" != \"${result%(deleted)}\" ]; then\n        kill -9 \"$pid\"\n    fi\ndone\n"}
